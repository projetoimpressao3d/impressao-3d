# =============================================================================
# Variáveis de Ambiente — Plataforma de Impressão 3D
# =============================================================================
# Copie este arquivo para .env.local (Next.js) ou .env (mesh-service)
# e preencha os valores reais. NUNCA commite o arquivo com valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Obtenha em: https://app.supabase.com → seu projeto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # ATENÇÃO: apenas no servidor/backend. Nunca expor ao cliente.

# -----------------------------------------------------------------------------
# Backend Python (mesh-service)
# Em desenvolvimento local: http://localhost:8000
# Em produção (Render): https://seu-servico.onrender.com
# -----------------------------------------------------------------------------
PYTHON_BACKEND_URL=               # ex: https://seu-servico.onrender.com
PYTHON_BACKEND_INTERNAL_TOKEN=    # token simples de autenticação entre Next.js e o backend

# -----------------------------------------------------------------------------
# IA — Fase 2 (não necessário para o MVP)
# Meshy: https://app.meshy.ai → Account → API Keys
# Anthropic: https://console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
MESHY_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Pagamentos — Stripe
# https://dashboard.stripe.com → Developers → API Keys
# ATENÇÃO: ao ativar o Stripe em produção, o plano Vercel precisa ser Pro
# (Vercel Hobby é restrito a uso não-comercial).
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=              # ex: http://localhost:3000 (dev) ou https://seu-dominio.com (prod)
